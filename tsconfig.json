{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "jsx": "react-jsx",
    "noEmit": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "types": ["node"],
    "lib": ["ES2023", "ESNext.Disposable", "DOM", "DOM.Iterable"]
  },
  "include": ["src/**/*.ts", "web/**/*.ts", "web/**/*.tsx", "vite.config.ts"]
}
