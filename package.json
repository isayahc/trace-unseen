{
  "name": "trace-unseen",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node node_modules/vite/bin/vite.js --host 127.0.0.1",
    "build": "npm run typecheck && node node_modules/vite/bin/vite.js build",
    "preview": "node node_modules/vite/bin/vite.js preview --host 127.0.0.1",
    "research:journey": "node --env-file-if-exists=.env --import tsx src/jobs/discover-tasks.ts --agent journey-researcher",
    "research": "node --env-file-if-exists=.env --import tsx src/jobs/discover-tasks.ts",
    "research:check": "node --env-file-if-exists=.env --import tsx src/jobs/discover-tasks.ts --check",
    "demo:load": "node --import tsx src/jobs/load-demo.ts",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test src/**/*.test.ts"
  },
  "dependencies": {
    "@dagrejs/dagre": "^3.1.3",
    "@opencode/plugin": "2.3.2",
    "@opencode/sdk": "2.3.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.187.0",
    "@xyflow/react": "^13.0.2",
    "jsonrepair": "^3.15.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-globe.gl": "^2.38.0",
    "three": "^0.187.0",
    "vite": "^8.3.8",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "node": "26.13.1",
    "tsx": "^4.0.0",
    "typescript": "^5.9.0"
  }
}
